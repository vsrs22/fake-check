# Copy to .env for local use. On a host (Render), set these as environment variables instead.
# Never commit .env or put a key in index.html.

# Required: from your Sightengine dashboard (API user and API secret)
SIGHTENGINE_API_USER=your-api-user
SIGHTENGINE_API_SECRET=your-api-secret

# Optional
# PORT=3000
# Free checks per visitor per day (default 5). Visitors are told apart by IP address.
# DAILY_LIMIT=5
# The day resets at midnight in this time zone.
# LIMIT_TIMEZONE=Asia/Kolkata
# Folder where daily counts are saved. Use a persistent disk on your host.
# DATA_DIR=./data
# Models used. Images: genai (AI-generated) and deepfake (face swaps). Each model uses operations on your plan.
# SIGHTENGINE_IMAGE_MODELS=genai,deepfake
# SIGHTENGINE_VIDEO_MODELS=genai
# Extra password for the whole site
# APP_PASSWORD=choose-a-password
